{
  "name": "tamirsuliman-weathermap-panel",
  "version": "1.6.21",
  "description": "A modernized, actively maintained network weathermap plugin for Grafana. Continuation of the original knightss27-weathermap-panel.",
  "scripts": {
    "postinstall": "patch-package",
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "npx playwright test",
    "e2e:local": "mkdir -p playwright/.auth && echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/admin.json && npx playwright test --project=run-tests --no-deps",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint --fix",
    "posttest": "make-coverage-badge",
    "release": "bash scripts/release.sh",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "repository": "github:allamiro/grafana-network-weathermap-ng",
  "author": "Tamir Suliman <allamiro@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/allamiro/grafana-network-weathermap-ng/issues",
    "email": "allamiro@gmail.com"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.1",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@swc/jest": "^0.2.39",
    "@swc/register": "^0.1.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.0.0",
    "@types/d3": "^6.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.6",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "braces": "file:vendor/braces",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.5",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^4.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^14.0.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^29.5.0",
    "make-coverage-badge": "^1.2.0",
    "patch-package": "^8.0.1",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.108.0",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.7",
