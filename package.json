    "nanoid": "^3.3.18",
    "js-yaml": "4.3.2",
    "brace-expansion": "5.0.12",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6",
    "braces": "$braces",
    "browserslist": "^4.28.9",
    "qs": "^6.17.0",
    "react-router-dom-v5-compat": {
      "react-router": "^7.18.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "deepmerge": "$deepmerge",
    "@jest/reporters": {
      "glob": "^14.0.4"
    },
    "jest-config": {
      "glob": "^14.0.4"
    },
    "jest-runtime": {
      "glob": "^14.0.4"
    },
    "test-exclude": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    }
  }
}
