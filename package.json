  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0 <25",
    "npm": ">=9"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@grafana/data": "^11.6.16",
    "@grafana/runtime": "^11.6.16",
    "@grafana/ui": "^11.6.16",
    "lodash.merge": "^4.6.2",
    "postcss": "^8.5.32",
    "prettier": "^2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.7.2",
    "tslib": "2.9.1",
    "typescript": "^5.4.0",
    "uuid": "^11.1.1"
  },
  "packageManager": "npm@9.6.6",
  "overrides": {
    "serialize-javascript": "7.1.4",
    "dompurify": "^3.4.17",
    "moment": "2.31.0",
    "js-cookie": "3.0.8",
